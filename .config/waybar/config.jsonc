{
  "position": "top",
  "height": 40,
  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["custom/spotify", "clock"],
  "modules-right": [
    "custom/vpn",
    "custom/pacman",
    "tray",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
  ],
  "clock": {
    "format": "{:%a %d %b - %H:%M}",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}% ",
    "format-warning": "{icon} {capacity}%",
    "format-critical": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}",
  },
  "network": {
    "format": "{ifname}",
    "interval": 2,
    "swap-icon-label": false,
    "format-wifi": "{essid} ({signalStrength}%)   {bandwidthDownBits}",
    "format-ethernet": "{ifname}   {bandwidthDownBits}",
    "format-linked": "{ifname} (No IP) no_entry",
    "format-disconnected": "",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) , {ipaddr}, {bandwidthDownBytes}, {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}, {ipaddr}, {bandwidthDownBytes}, {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 40,
    "on-click": "nm-connection-editor",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "],
    },
    "on-click": "pavucontrol",
  },
  "bluetooth": {
    "format": " {status}",
    "swap-icon-label": false,
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "custom/spotify": {
    "format": " {}",
    "max-length": 60,
    "interval": 10,
    "on-click": "playerctl -p spotify play-pause",
    "on-click-right": "killall spotify",
    "on-scroll-up": "playerctl -p spotify next",
    "on-scroll-down": "playerctl -p spotify previous",
    "exec": "$HOME/.config/waybar/mediaplayer.sh 2> /dev/null",
    "exec-if": "pgrep spotify",
  },
  "custom/vpn": {
    "interval": 3,
    "format": "{}",
    "exec": "$HOME/.config/waybar/vpn.sh",
    "max-length": 15,
  },
  "custom/pacman": {
    "format": " {}",
    "interval": 3600,
    "exec": "checkupdates | wc -l",
    "on-click": "kitty -d / -e sudo pacman -Syu",
    "signal": 8,
  },
  "tray": {
    "icon-size": 14,
    "spacing": 5,
  },
    "return-type": "json",
    "exec-if": "which swaync",
    "exec": "swaync -swb",
    "on-click": "swaync -t -sw",
    "on-click-right": "swaync -d -sw",
    "escape": true,
  }
}
