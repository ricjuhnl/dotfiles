# -------------------------------------------------------------------
# Web Apps - Install and launch web apps as standalone windows
# -------------------------------------------------------------------

# Directory for user web-app desktop entries (icons + desktop files live here)
WEBAPP_DIR="$HOME/.local/share/applications/webapps"
# Symlinks go here so rofi can find them
WEBAPP_LINKS="$HOME/.local/share/applications"

# Browser to use for web apps (must support --app flag, i.e. Chromium-based)
WEBAPP_BROWSER="brave --ozone-platform=x11"

# Install a web app
# Usage: webapp-install <name> <url> [icon_url]
function webapp-install() {
  local name="$1"
  local url="$2"
  local icon_url="$3"

  if [[ -z "$name" || -z "$url" ]]; then
    echo "Usage: webapp-install <name> <url> [icon_url]"
    return 1
  fi

  # Create directory if needed
  mkdir -p "$WEBAPP_DIR"

  local basename="${name:l}"
  local desktop_file="$WEBAPP_DIR/${basename}.desktop"
  local link_file="$WEBAPP_LINKS/${basename}.desktop"
  local icon_path="$WEBAPP_DIR/${basename}.png"

  # Check if already installed
  if [[ -f "$desktop_file" ]]; then
    echo "Error: '$name' is already installed."
    echo "Remove it first with: webapp-remove $name"
    return 1
  fi

  # Fetch favicon if no icon provided
  if [[ -z "$icon_url" ]]; then
    local favicon_url
    favicon_url=$(curl -sI "$url" 2>/dev/null | grep -i location | head -1 | awk '{print $2}' | sed 's/[^/]*$//')
    favicon_url="${favicon_url:-$url}/favicon.ico"
    icon_url="$favicon_url"
  fi

  # Try to download icon
  if command -v curl &>/dev/null; then
    if ! curl -sL --max-time 5 -o "$icon_path" "$icon_url" 2>/dev/null; then
      # Fallback: try favicon from the URL's domain
      local domain
      domain=$(echo "$url" | sed 's|https\?://||; s|/.*||')
      icon_url="https://${domain}/favicon.ico"
      curl -sL --max-time 5 -o "$icon_path" "$icon_url" 2>/dev/null || rm -f "$icon_path"
    fi
  fi

  # Determine icon argument
  local icon_arg
  if [[ -f "$icon_path" ]]; then
    icon_arg="Icon=$icon_path"
  else
    # Use a generic browser icon as fallback
    icon_arg="Icon=web-browser"
  fi

  # Write the desktop file (no URL key - only valid for Type=Link)
  cat > "$desktop_file" <<EOF
[Desktop Entry]
Name=$name
Type=Application
${icon_arg}
Exec=$WEBAPP_BROWSER --app="$url" %u
MimeType=text/html;text/xml;application/xhtml+xml;application/vnd.mozilla.xul+xml;text/mml+xhtml
StartupNotify=true
Terminal=false
Categories=Network;WebBrowser;
Keywords=Web;Application;
EOF

  # Make .desktop files executable
  chmod +x "$desktop_file"

  # Symlink into ~/.local/share/applications so rofi finds them
  rm -f "$link_file"
  ln -sf "$desktop_file" "$link_file"

  echo "Installed: $name"
  echo "  URL:     $url"
  echo "  File:    $desktop_file"
  [[ -f "$icon_path" ]] && echo "  Icon:    $icon_path"
}

# Remove a web app
# Usage: webapp-remove <name>
function webapp-remove() {
  local name="$1"

  if [[ -z "$name" ]]; then
    echo "Usage: webapp-remove <name>"
    return 1
  fi

  local basename="${name:l}"
  local desktop_file="$WEBAPP_DIR/${basename}.desktop"
  local link_file="$WEBAPP_LINKS/${basename}.desktop"
  local icon_path="$WEBAPP_DIR/${basename}.png"

  if [[ ! -f "$desktop_file" ]]; then
    echo "Error: '$name' is not installed."
    return 1
  fi

  rm -f "$desktop_file" "$icon_path" "$link_file"
  echo "Removed: $name"
}

# List installed web apps
function webapp-list() {
  echo "Installed web apps:"
  local f
  for f in "${WEBAPP_DIR}"/*.desktop; do
    [[ -f "$f" ]] || continue
    local name
    name=$(grep '^Name=' "$f" | head -1 | cut -d= -f2-)
    local url
    url=$(grep 'Exec=' "$f" | head -1 | sed 's|.*--app="\([^"]*\)".*|\1|')
    printf "  %-20s %s\n" "$name" "$url"
  done
}