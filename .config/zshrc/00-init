# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR=micro
export VAULT_ADDR="https://vault.prod.dh.unimaas.nl"
export WLR_NO_HARDWARE_CURSORS=1
export ZSH="/usr/bin/zsh"
export MICRO_TRUECOLOR=1
export BUN_INSTALL="$HOME/.bun"
export TZ="Europe/Amsterdam"
export XDG_CURRENT_DESKTOP=niri:GNOME
# -----------------------------------------------------
# PATH
# -----------------------------------------------------
export PATH="$HOME/.local/bin:$BUN_INSTALL/bin:$HOME/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/sbin:/usr/sbin"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Pi
export PATH="$HOME/.pi/agent/bin:$PATH"
