window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.9
    background-effect {
        blur true
    }
}
// Zen Browser — extension popups have dynamic titles set after creation,
// so title-based open-floating never matches. Float all zen windows instead.
window-rule {
    match app-id="zen"
    open-floating true
}
window-rule {
    match app-id=r"blueman-manager$"
    default-column-width {
    }
    open-floating true
}
window-rule {
    match app-id=r"nm-connection-editor$"
    default-column-width {
    }
    open-floating true
}
window-rule {
    match app-id=r"pavucontrol$"
    default-column-width { proportion 0.25; }
    default-window-height { fixed 800; }
    open-floating true
}
window-rule {
    match title="openconnect-saml"
    open-maximized false
    open-floating true
    default-column-width { proportion 0.15; }
    default-window-height { fixed 500; }
}
window-rule {
    match app-id="kitty"
    open-floating false
    default-column-width { proportion 0.25; }
}

window-rule {
    match is-focused=true
    background-effect {
        blur true
    }
}
