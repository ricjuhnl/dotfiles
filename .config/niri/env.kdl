// Spawn settings
spawn-sh-at-startup "export PATH=/home/rjuhasz/.local/bin:$PATH; exec /home/rjuhasz/.local/bin/yami-shell"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "/usr/lib/xdg-desktop-portal-gtk"
spawn-at-startup "/usr/lib/xdg-desktop-portal-gnome"

environment {
  XDG_CURRENT_DESKTOP "niri"
  MOZ_ENABLE_WAYLAND "1"
  QT_QPA_PLATFORM "wayland"
  ELECTRON_OZONE_PLATFORM_HINT "wayland"
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_QPA_PLATFORMTHEME_QT6 "gtk3"
  TERMINAL "kitty"
  XCURSOR_THEME "Nordzy-cursors-white"
  XCURSOR_SIZE "24"
}
cursor {
  xcursor-theme "Nordzy-cursors-white"
}

hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
